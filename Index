<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0B7F47">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="সেবা">
<link rel="manifest" href="manifest.json">
<title>আমাদের সেবা</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@400;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/peerjs@1.5.4/dist/peerjs.min.js"></script>
<style>
  :root{--green:#0B7F47;--green-soft:#E6F4EA;--red-soft:#FCE8E8;--blue-soft:#E6EEF9;--purple-soft:#F0EAF9;--bg:#F7F8F7;--card:#fff;--text:#111;--muted:#5d6b63;--border:#E3E6E4}
  @media (prefers-color-scheme: dark){:root{--bg:#101412;--card:#1a201c;--text:#f2f4f3;--muted:#9aa8a0;--border:#2a332e;--green-soft:#173325}}
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{height:100%;background:var(--bg);color:var(--text);font-family:"Noto Sans Bengali",system-ui,sans-serif}
  body{padding:env(safe-area-inset-top,0) 0 env(safe-area-inset-bottom,0)}
  [hidden]{display:none!important}
  .app{max-width:520px;height:100vh;margin:0 auto;display:flex;flex-direction:column}
  header{background:var(--green);color:#fff;padding:16px 18px;font-size:18px;font-weight:700}
  main{flex:1;overflow-y:auto;padding:14px}
  nav{display:flex;justify-content:space-around;background:var(--card);border-top:1px solid var(--border);padding:8px 0 10px}
  nav button{background:none;border:none;font:inherit;font-size:12px;color:var(--muted);display:flex;flex-direction:column;align-items:center;gap:2px;padding:4px 14px}
  nav button.on{color:var(--green);font-weight:700}
  .card{background:var(--card);border:1px solid var(--border);border-radius:18px;padding:14px;margin-bottom:12px}
  .muted{font-size:13px;color:var(--muted);line-height:1.5}
  .idbox{display:flex;align-items:center;justify-content:space-between;gap:8px;background:var(--green-soft);border-radius:16px;padding:12px 14px;margin-bottom:12px}
  .idbox b{font-family:monospace;font-size:16px;color:var(--green);word-break:break-all}
  .row{display:flex;gap:8px;margin-bottom:12px}
  input{flex:1;min-width:0;background:var(--card);border:1px solid var(--border);border-radius:14px;padding:12px 14px;font:inherit;font-size:15px;color:var(--text)}
  button.pri{background:var(--green);color:#fff;border:none;border-radius:14px;padding:12px 16px;font:inherit;font-weight:700;white-space:nowrap}
  button.ghost{background:var(--card);color:var(--green);border:1px solid var(--green);border-radius:14px;padding:8px 12px;font:inherit;font-size:13px}
  .msg{max-width:78%;padding:9px 13px;border-radius:16px;font-size:15px;line-height:1.5;margin-bottom:8px;word-wrap:break-word}
  .in{background:var(--card);border:1px solid var(--border);margin-right:auto;border-top-left-radius:6px}
  .out{background:var(--green);color:#fff;margin-left:auto;border-top-right-radius:6px}
  .status{text-align:center;font-size:12px;color:var(--muted);margin:8px 0}
  #msgs{display:flex;flex-direction:column;min-height:200px;margin-bottom:12px}
  .stage{position:relative;background:#000;border-radius:18px;overflow:hidden;aspect-ratio:3/4;margin-bottom:12px}
  #remote{width:100%;height:100%;object-fit:cover}
  #local{position:absolute;right:10px;bottom:10px;width:30%;max-width:120px;aspect-ratio:3/4;border-radius:12px;object-fit:cover;border:2px solid #fff;background:#222}
  .danger{width:100%;background:#C62828;color:#fff;border:none;border-radius:16px;padding:14px;font:inherit;font-weight:700;font-size:16px}
  .svc{display:flex;align-items:center;gap:12px;padding:14px 0;border-bottom:1px solid var(--border);font-size:15px}
  .svc:last-child{border-bottom:none}
  .svc i{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;font-style:normal;flex-shrink:0}
  .svc span{flex:1}
  .soon{font-size:12px;color:var(--muted)}
</style>
</head>
<body>
<div class="app">
  <header>আমাদের সেবা</header>
  <main>
    <!-- চ্যাট -->
    <section id="s-chat">
      <div class="idbox">
        <div><div class="muted">আপনার ID</div><b id="myid">তৈরি হচ্ছে…</b></div>
        <button class="ghost" id="copy">কপি</button>
      </div>
      <div class="row">
        <input id="friend" placeholder="বন্ধুর ID লিখুন">
        <button class="pri" id="btnConnect">সংযোগ</button>
      </div>
      <div class="status" id="cstatus">কারও সাথে সংযুক্ত নন</div>
      <div id="msgs"></div>
      <div class="row">
        <input id="txt" placeholder="বার্তা লিখুন…">
        <button class="pri" id="send">পাঠান</button>
      </div>
    </section>

    <!-- ভিডিও কল -->
    <section id="s-call" hidden>
      <div class="stage">
        <video id="remote" autoplay playsinline></video>
        <video id="local" autoplay playsinline muted></video>
      </div>
      <div id="callInfo" class="status">কলের জন্য বন্ধুর ID দিন</div>
      <div class="row" id="callRow">
        <input id="friend2" placeholder="বন্ধুর ID লিখুন">
        <button class="pri" id="btnCall">ভিডিও কল</button>
      </div>
      <button class="danger" id="hang" hidden>কল শেষ</button>
    </section>

    <!-- সেবা (অন্যান্য অপশন) -->
    <section id="s-menu" hidden>
      <div class="card">
        <div class="svc"><i style="background:var(--red-soft)">▭</i><span>মোবাইল ব্যাংকিং</span><small class="soon">শীঘ্রই</small></div>
        <div class="svc"><i style="background:var(--blue-soft)">✓</i><span>পরিচয় যাচাই</span><small class="soon">শীঘ্রই</small></div>
        <div class="svc"><i style="background:var(--purple-soft)">⚿</i><span>নিরাপত্তা</span><small class="soon">শীঘ্রই</small></div>
        <div class="svc"><i style="background:var(--green-soft)">৳</i><span>লোন, DPS, FDR, MFS</span><small class="soon">শীঘ্রই</small></div>
      </div>
      <p class="muted">ব্যাংকিং সেবাগুলো অনুমোদিত প্রতিষ্ঠানের সাথে সংযোগ হওয়ার পর চালু হবে।</p>
    </section>
  </main>
  <nav>
    <button class="on" data-t="s-chat">💬<span>চ্যাট</span></button>
    <button data-t="s-call">📹<span>ভিডিও কল</span></button>
    <button data-t="s-menu">▦<span>সেবা</span></button>
  </nav>
</div>

<script>
  // ---- নিজের ID (একবার তৈরি হয়ে ফোনে সংরক্ষিত থাকে) ----
  let myId = localStorage.getItem('sheba-id');
  if (!myId) {
    myId = 'sheba-' + Math.random().toString(36).slice(2, 8);
    localStorage.setItem('sheba-id', myId);
  }
  const $ = id => document.getElementById(id);
  const peer = new Peer(myId, { debug: 1 });
  let conn = null, mediaCall = null, localStream = null;

  peer.on('open', id => { $('myid').textContent = id; $('cstatus').textContent = 'অনলাইন — বন্ধুর ID দিয়ে সংযোগ করুন'; });
  peer.on('error', e => { $('cstatus').textContent = 'সমস্যা: ' + e.type; });

  // ---- চ্যাট ----
  function addMsg(text, who) {
    const d = document.createElement('div');
    d.className = 'msg ' + who;
    d.textContent = text;
    $('msgs').appendChild(d);
    d.scrollIntoView({ block: 'end' });
  }
  function bindConn(c) {
    conn = c;
    c.on('open', () => { $('cstatus').textContent = 'সংযুক্ত: ' + c.peer; });
    c.on('data', d => addMsg(d, 'in'));
    c.on('close', () => { $('cstatus').textContent = 'সংযোগ বিচ্ছিন্ন'; conn = null; });
  }
  peer.on('connection', bindConn);
  $('btnConnect').onclick = () => {
    const id = $('friend').value.trim();
    if (id) bindConn(peer.connect(id, { reliable: true }));
  };
  $('send').onclick = () => {
    const t = $('txt').value.trim();
    if (!t) return;
    if (!conn || !conn.open) { $('cstatus').textContent = 'আগে বন্ধুর সাথে সংযোগ করুন'; return; }
    conn.send(t); addMsg(t, 'out'); $('txt').value = '';
  };
  $('txt').addEventListener('keydown', e => { if (e.key === 'Enter') $('send').click(); });
  $('copy').onclick = () => navigator.clipboard?.writeText(myId);

  // ---- ভিডিও কল ----
  async function getMedia() {
    if (!localStream) {
      localStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
      $('local').srcObject = localStream;
    }
    return localStream;
  }
  function attachCall(c) {
    mediaCall = c;
    c.on('stream', s => { $('remote').srcObject = s; $('callInfo').textContent = 'কল চলছে'; });
    c.on('close', endCall);
    $('hang').hidden = false;
  }
  $('btnCall').onclick = async () => {
    const id = $('friend2').value.trim();
    if (!id) return;
    try {
      const s = await getMedia();
      $('callInfo').textContent = 'কল করা হচ্ছে…';
      attachCall(peer.call(id, s));
    } catch (e) { $('callInfo').textContent = 'ক্যামেরা/মাইক্রোফোন অনুমতি দিন'; }
  };
  peer.on('call', async c => {
    if (!confirm('ভিডিও কল আসছে। গ্রহণ করবেন?')) { c.close(); return; }
    try {
      const s = await getMedia();
      c.answer(s);
      attachCall(c);
      showTab('s-call');
    } catch (e) { c.close(); }
  });
  function endCall() {
    if (mediaCall) mediaCall.close();
    mediaCall = null;
    $('remote').srcObject = null;
    $('hang').hidden = true;
    $('callInfo').textContent = 'কল শেষ হয়েছে';
  }
  $('hang').onclick = endCall;

  // ---- ট্যাব ----
  function showTab(id) {
    ['s-chat','s-call','s-menu'].forEach(s => $(s).hidden = s !== id);
    document.querySelectorAll('nav button').forEach(b => b.classList.toggle('on', b.dataset.t === id));
  }
  document.querySelectorAll('nav button').forEach(b => b.onclick = () => showTab(b.dataset.t));

  // ---- সার্ভিস ওয়ার্কার (ইনস্টল ও অফলাইন শেল) ----
  if ('serviceWorker' in navigator) navigator.serviceWorker.register('sw.js');
</script>
</body>
</html>
